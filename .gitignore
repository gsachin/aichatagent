# Secrets
.env

# Machine profile snapshot (generated by scripts/predeploy.py)
.machine_profile.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Test artifacts
tests/test_results/*.wav
test_out.wav
test_tts_output.wav
test_voice_output.wav
test_voice_pipeline.wav
app/static/audio/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini

# ChromaDB (large binary files) — legacy data; runtime no longer uses it

# Benchmark artifacts and Indic-TTS checkpoints (~1.5 GB per language)
doc/perf/results/
tts_service/checkpoints/

# Pytest
.pytest_cache/

# Runtime logs
logs/

# pip install serialization lock (bootstrap_services.py)
.pip-install.lock

# Cloudflare tunnel hostname (changes every restart)
.whatsapp_tunnel
.tunnel_*

# Windows NUL device artifact
NUL

# Task tracking (local only)
pendingtask*.md

# Uploaded documents and generated offer letters (sensitive data)
data/

# Env backups (a plain .env pattern does NOT cover .env.bak-*) — these hold secrets
.env.*
*.env.bak*

# DSPMU site-index raw cache (regenerate with scripts/build_site_index.py).
# The generated markdown/JSON and notices.sqlite3 in content/dspmu/ are tracked.
content/dspmu/cache/
content/dspmu/nga_graph.sqlite3
content/dspmu/nga_graph.sqlite3-*
content/dspmu/*.sqlite3.tmp
content/dspmu/*.sqlite3.tmp-*
content/dspmu/*.sqlite3-journal
content/dspmu/*.sqlite3-wal
content/dspmu/*.sqlite3-shm
# Phase 10 runtime state: latest refresh report and the worker's advisory lock.
content/dspmu/nga_refresh_report.json
content/dspmu/nga_refresh.lock
# Extracted notice bodies can contain personal data until reviewed; never commit.
content/dspmu/notice_bodies/
# Tesseract language data (~12 MB); install with scripts/install_hindi_ocr.py.
.tessdata/
.siteindex-ocr-*/
