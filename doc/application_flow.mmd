    WS_CLIENT -.->|"ws://localhost:8000"| WS_ENDPOINT
    MEDIA_WS -.->|"ws://localhost:8000"| WS_TWILIO_EP["/ws/twilio"]
    WS_ENDPOINT --> PIPELINE
    WS_TWILIO_EP --> PIPELINE
    CORE --> WS_ENDPOINT
    CORE --> WS_TWILIO_EP

