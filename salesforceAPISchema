          type: string
          description: Unique identifier for this upload session
        application_no:
          type: string
        file_name:
          type: string
        total_chunks:
          type: integer
        status:
          type: string
          example: "initiated"

    ChunkUploadResponse:
      type: object
      required:
        - upload_id
        - chunk_number
        - received_chunks
        - total_chunks
        - status
      properties:
        upload_id:
          type: string
        chunk_number:
          type: integer
        received_chunks:
          type: integer
          description: Number of chunks received so far
        total_chunks:
          type: integer
        status:
          type: string
          example: "uploaded"

    UploadCompleteResponse:
      type: object
      required:
        - upload_id
        - application_no
        - status
        - document
      properties:
        upload_id:
          type: string
        application_no:
          type: string
        status:
          type: string
          example: "completed"
        document:
          $ref: '#/components/schemas/DocumentResponse'

    DocumentVerificationUpdate:
      type: object
      required:
        - verification_status
      properties:
        verification_status:
          type: string
          enum:
            - Pending
            - Verified
            - Rejected
        rejection_reason:
          type: string
          nullable: true
          description: Required if verification_status is "Rejected"
        verified_by:
          type: string
          nullable: true

    UserLookupCreateRequest:
      type: object
      required:
        - name
        - email
        - phoneNumber
        - conversationId
      properties:
        name:
          type: string
        email:
          type: string
          format: email
        phoneNumber:
          type: string
        conversationId:
          type: string
        course:
          type: string
          nullable: true

    UserResponse:
      type: object
      required:
        - userId
        - name
        - email
        - phoneNumber
        - conversationId
      properties:
        userId:
          type: string
        name:
          type: string
        email:
          type: string
          format: email
        phoneNumber:
          type: string
        conversationId:
          type: string
        course:
          type: string
          nullable: true
        sentiment:
          type: string
          nullable: true
        offerLetterReleased:
          type: boolean
          default: false
        offerLetterAccepted:
          type: string
          nullable: true

    UserStatusUpdateRequest:
      type: object
      properties:
        sentiment:
          type: string
          nullable: true
        offerLetterReleased:
          type: boolean
          nullable: true
        offerLetterAccepted:
          type: string
          nullable: true