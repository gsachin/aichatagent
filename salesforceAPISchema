            - Pending
            - Verified
            - Rejected
          nullable: true
        rejection_reason:
          type: string
          nullable: true
        verified_by:
          type: string
          nullable: true
        verified_at:
          type: string
          format: date-time
          nullable: true

    UploadInitializeResponse:
      type: object
      required:
        - upload_id
        - application_no
        - file_name
        - total_chunks
