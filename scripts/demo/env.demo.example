# UniversityBotDemoAPI - demo environment template
# Copy to .env and fill the blank secrets. NEVER commit .env.
# The demo uses the same model, prompts, voices, and language settings as the
# approved development version. Only the database and secrets differ.
#
# DATABASE_URL targets admissions_demo. demo_setup.ps1 -InitDb fills the
# __DEMO_DB_PASSWORD__ placeholder with a generated password and replaces the
# port with the elearning-postgres container's published host port (9200 on
# this machine; the container is not published on 5432).
# CRM is live by default. Twilio/WhatsApp need live credentials for a phone or
# WhatsApp demonstration; the browser UI and browser voice work without them.

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=0
FASTAPI_PORT=8000
FASTAPI_HOST=127.0.0.1
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
VAD_SILENCE_MS=600
VAD_SPECULATIVE_ADVANCE_MS=220
BARGE_IN_ENABLED=1
BARGE_IN_ECHO_GAIN=0.5
BARGE_IN_MARGIN=2.0
BARGE_IN_ABS_FLOOR=150
BARGE_IN_MIN_FRAMES=6
BARGE_IN_REF_DECAY=0.95
LLM_STREAM=1
TTS_STREAM=1
TURN_TIMEOUT_S=30
GROUNDING_ENABLED=1
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
TTS_CACHE_SCOPE=per_call
MAX_CONCURRENT_CALLS=2
ADMISSION_ENABLED=true
COMPANY_NAME=Dr. Shyama Prasad Mukherjee University
AGENT_NAME=Alex
DATABASE_URL=postgresql://demo_user:__DEMO_DB_PASSWORD__@127.0.0.1:__DEMO_DB_PORT__/admissions_demo
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
LOG_LEVEL=INFO
LOG_FILE=./logs/voice_assistant.log
LLM_PROVIDER=auto
SMALL_TASK_NUM_CTX=8192
WHISPER_MODEL=small
STT_LANGUAGE=auto
STT_LANGUAGE_MIN_PROB=0.5
WHISPER_NUM_THREADS=4
FASTAPI_WORKERS=4
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=15
LLM_MAX_TOKENS=192
LLM_REASONING_EFFORT=none
LLM_PROMPT_CACHE_KEY=dspmu-kb-v3
CONTEXT_MODE=doc
DOC_PATHS=content/dspmu/core_cards.md,content/dspmu/site_map.md,content/dspmu/recent_notices.md
DOC_MAX_BYTES=2000000
DOC_MAX_TOKENS=500000
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,as,bn,brx,gu,kn,ml,mni,mr,or,raj,ta,te,es,fr,it,ja,pt,zh
FOREIGN_LANGUAGES=es,fr,it,ja,pt,zh
OUTBOUND_LANGUAGE_MENU=1
WHATSAPP_LANGUAGE_MENU=1
GROUNDING_LANGUAGE_MODE=relaxed
TTS_PROVIDER=sarvam
SARVAM_TTS_LANGUAGES=gu,hi
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=
SARVAM_TTS_SPEAKERS=gu:pooja_gu_customer,hi:aparna_hi_customer
SARVAM_TTS_PACE=1.1
SARVAM_TTS_SAMPLE_RATE=8000
SARVAM_TTS_TIMEOUT_S=15
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech/stream
INDIC_TTS_URL=http://127.0.0.1:8020
INDIC_TTS_LANGUAGE=hi
CRM_ENABLED=true
CRM_BASE_URL=http://127.0.0.1:8098
CRM_IDLE_WINDOW_HOURS=6
CRM_OFFER_UPLOAD_ENABLED=true
CRM_OFFER_DOCUMENT_TYPE=Other
CRM_OFFER_DOCUMENT_SOURCE=Internal Upload
CRM_DOCUMENT_UPLOAD_ENABLED=true
STT_PROVIDER=sarvam
STT_FALLBACK_PROVIDERS=indic_conformer,whisper
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
SARVAM_STT_TIMEOUT_S=8
INDIC_CONFORMER_MODEL_HI=OpenVoiceOS/ai4bharat-indicconformer-hi-onnx
INDIC_CONFORMER_MODEL_GU=OpenVoiceOS/ai4bharat-indicconformer-gu-onnx
INDIC_CONFORMER_QUANTIZATION=int8
INDIC_CONFORMER_DEVICE=cpu
STT_SPECULATIVE_ENABLED=1
BACKEND_BASE=http://127.0.0.1:8000
