# Environment Configuration Template
# This file is auto-generated by setup.sh
# Edit values below to customize your setup

# ───────────────────────────────────────────────────────────────────
# Python Configuration
# ───────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=0

# ───────────────────────────────────────────────────────────────────
# LLM Backend Selection (see app/llm_backend.py)
# ───────────────────────────────────────────────────────────────────
# auto = MLX on Apple Silicon (Darwin+arm64), Ollama everywhere else.
# Force a backend with: LLM_PROVIDER=ollama or LLM_PROVIDER=mlx
# NOTE for Docker: containers run Linux, so leave this unset/auto —
# setting LLM_PROVIDER=mlx inside containers would look for a local
# MLX server that only exists on the Mac host.
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Ollama LLM Server Configuration (Windows / Linux)
# ───────────────────────────────────────────────────────────────────
# URL to Ollama server (default: local)
OLLAMA_URL=http://localhost:11434

# Model to use and context window size — sized per machine by
# scripts/predeploy.py (see the Machine Profile block at the bottom).
# Q3_K_M chosen for 6 GB VRAM cards; 14B/7B-4bit MLX on Apple Silicon.
# Voice calls run the production voice system prompt (~3.5k tokens) plus
# RAG context, so the context window must stay ≥8192 where RAM allows.

# Temperature (0.0-1.0): 0=deterministic, 1=creative
# 0.3 = grounded QA (live value); empty = Ollama default
OLLAMA_TEMPERATURE=0.3

# ───────────────────────────────────────────────────────────────────
# Apple MLX LLM Server Configuration (macOS Apple Silicon)
# ───────────────────────────────────────────────────────────────────
# mlx_lm.server (OpenAI-compatible) started by start_services.sh /
# bootstrap_services.py — replaces Ollama for LLM inference on Mac.
MLX_BASE_URL=http://127.0.0.1:1234
MLX_PORT=1234

# MLX model repo on HuggingFace (~9 GB download, ~11 GB unified RAM).
# Smaller/faster alternative: mlx-community/Qwen2.5-7B-Instruct-4bit
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# Local embedding model on Mac (no Ollama there); 768-dim nomic family,
# dimension-compatible with the Ollama nomic-embed-text store.
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# FastAPI Server Configuration
# ───────────────────────────────────────────────────────────────────
# Port to run FastAPI on
FASTAPI_PORT=8000

# Host to bind to (0.0.0.0 = accept from any host)
FASTAPI_HOST=0.0.0.0

# Number of worker processes (in production)
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Streamlit Web UI Configuration
# ───────────────────────────────────────────────────────────────────
# Port to run Streamlit on (usually FASTAPI_PORT + 501)
STREAMLIT_PORT=8501

# Run in headless mode (no browser opening)
STREAMLIT_SERVER_HEADLESS=true

# ───────────────────────────────────────────────────────────────────
# Speech-to-Text (Whisper) Configuration
# ───────────────────────────────────────────────────────────────────
# Model size (options: tiny.en, base.en, small.en, medium.en, large)
# tiny: 39M, base: 74M, small: 244M, medium: 769M, large: 3.1G
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# Number of threads for computation
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Text-to-Speech (Kokoro) Configuration
# ───────────────────────────────────────────────────────────────────
# Voice to use (options: af_heart, am_adam, bf_emma, bm_george, etc)
KOKORO_VOICE=af_heart

# Speaking speed (0.5-2.0, default: 1.0)
KOKORO_SPEED=1.0

# ───────────────────────────────────────────────────────────────────
# Voice Agent Identity (app/voice_system_prompt.py)
# ───────────────────────────────────────────────────────────────────
# How the voice agent introduces itself on calls. Used to fill the
# [COMPANY_NAME] / [AGENT_NAME] placeholders in the production voice
# system prompt.
COMPANY_NAME=Meridian University
AGENT_NAME=Alex

# ───────────────────────────────────────────────────────────────────
# Vector Database (Chroma) Configuration
# ───────────────────────────────────────────────────────────────────
# Path to Chroma database (default: ./chroma_local_db)
CHROMA_DB_PATH=./chroma_local_db

# Retrieval mode: "mmr" (default) or "hybrid" (dense + BM25 + RRF)
RAG_SEARCH_MODE=hybrid

# Number of results to retrieve for RAG — sized by scripts/predeploy.py
# (see the Machine Profile block at the bottom).

# Candidate pool size for retrieval — sized by scripts/predeploy.py
# (see the Machine Profile block at the bottom).

# Similarity threshold gate (cosine distance): 0.0 = DISABLED (live value —
# measured distances overlap between valid and off-topic questions, so a
# global gate would reject valid ones; revisit with per-section gating)
RAG_SIMILARITY_THRESHOLD=0.0

# Context overflow guard: 0 = off (warn only); N = trim context to N chars
RAG_MAX_CONTEXT_CHARS=0

# Embedding model served by Ollama for the vector store
EMBED_MODEL=nomic-embed-text

# ───────────────────────────────────────────────────────────────────
# Integrations — fill these in for full functionality
# (bootstrap_services copies this template to .env on first run)
# ───────────────────────────────────────────────────────────────────
# Twilio (voice + WhatsApp) — https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# PostgreSQL connection (Docker compose default credentials shown;
# docker-compose.yml overrides the host to `postgres` inside the network)
DATABASE_URL=postgresql://elearning:elearning_secret@localhost:5432/admissions

# SMTP for offer-letter email delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ───────────────────────────────────────────────────────────────────
# Logging Configuration
# ───────────────────────────────────────────────────────────────────
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=./logs/voice_assistant.log

# ───────────────────────────────────────────────────────────────────
# GPU/Compute Configuration (Auto-detected)
# ───────────────────────────────────────────────────────────────────
# These are auto-detected by app/platform.py
# Only override if needed
# DEVICE=cuda  # or mps (Metal GPU), cpu
# COMPUTE_TYPE=int8  # or fp16, fp32

# ───────────────────────────────────────────────────────────────────
# Machine Profile (managed by scripts/predeploy.py — do not edit)
# ───────────────────────────────────────────────────────────────────
# The keys below are sized automatically for the machine at deploy
# time (RAM/VRAM/cores → model, context window, threads, workers).
# The block is rewritten on every predeploy run. To override a value
# manually, move it ABOVE this section (outside the block) — the app
# reads the value outside the block and predeploy will not touch it.
# Sizes: MACHINE_PROFILE_CHECK=0 disables the startup drift warning.
# === MACHINE PROFILE — auto-generated by scripts/predeploy.py (do not edit) ===
LLM_PROVIDER=auto
MLX_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit
MLX_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
OLLAMA_MODEL=qwen2.5:7b-instruct-q3_K_M
OLLAMA_NUM_CTX=8192
WHISPER_MODEL=small.en
WHISPER_NUM_THREADS=4
FASTAPI_WORKERS=4
RAG_TOP_K=5
RAG_FETCH_K=20
# === END MACHINE PROFILE ===


# === Enterprise RAG Core (MCP-first retrieval) ===
# MCP retrieval mode: auto (default) = MCP first, automatic fallback to the
# local ChromaDB store; on = MCP only; off = local store only.
USE_MCP_RAG=auto
# enterprise-rag-core MCP service (started by start_services.ps1 Step 6b)
RAG_MCP_URL=http://127.0.0.1:8010/mcp
# Read timeout (s) and circuit-breaker cooldown (s) for the MCP client
RAG_MCP_TIMEOUT=2.5
RAG_MCP_COOLDOWN=30
