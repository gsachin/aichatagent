# Environment Configuration Template
# This file is maintained alongside bootstrap_services.py
# Edit values below to customize your setup

# ───────────────────────────────────────────────────────────────────
# Python Configuration
# ───────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=0

# ───────────────────────────────────────────────────────────────────
# FastAPI Server Configuration
# ───────────────────────────────────────────────────────────────────
# Port to run FastAPI on
FASTAPI_PORT=8000

# Host to bind to (0.0.0.0 = accept from any host)
FASTAPI_HOST=0.0.0.0

# Number of worker processes (in production)
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Streamlit Web UI Configuration
# ───────────────────────────────────────────────────────────────────
# Port to run Streamlit on (usually FASTAPI_PORT + 501)
STREAMLIT_PORT=8501

# Run in headless mode (no browser opening)
STREAMLIT_SERVER_HEADLESS=true

# ───────────────────────────────────────────────────────────────────
# Speech-to-Text (Whisper) Configuration
# ───────────────────────────────────────────────────────────────────
# Model size (options: tiny.en, base.en, small.en, medium.en, large)
# tiny: 39M, base: 74M, small: 244M, medium: 769M, large: 3.1G
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# Number of threads for computation
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Endpointing — the end-of-speech decision (BRD-04)
# ───────────────────────────────────────────────────────────────────
# BRD-04 requires exactly ONE live end-of-speech decision, its delay
# documented, and its value reconciled against BRD-02. This is it. There is no
# second VAD on the Twilio path; a second Silero VAD with stop_secs=0.5 used to
# be constructed in app/pipeline.py and never attached to anything, announcing
# itself in the log as if it were live. It was removed.
#
# 600 ms is the pause tolerance given to the caller, and it is 86% of BRD-02's
# 700 ms budget before STT has run (AS-04), so BRD-02 is not reachable by
# tuning this number. Do not lower it casually: the load fixtures encode a
# 240 ms mid-turn hesitation as real caller behaviour, so anything at or below
# ~400 ms will split callers who pause mid-sentence -- and the harness CANNOT
# detect that, because its fixtures present no hesitation between 240 ms and
# the threshold. A latency win taken here is a win the test suite cannot audit.
VAD_SILENCE_MS=600

# Speculative STT: transcribe the audio-so-far while the remaining pause is
# still being counted, so the ~200 ms STT pass is no longer added to the
# caller's wait. This does NOT close the turn early and does NOT change the
# delay -- the caller still gets the full VAD_SILENCE_MS. The result is used
# only if the audio did not change (caller resumed -> discarded), so the
# transcript is identical by construction and the caller hears no difference.
# 0 disables it. 220 ms is the measured STT p50 (203 ms) rounded up.
VAD_SPECULATIVE_ADVANCE_MS=220

# ───────────────────────────────────────────────────────────────────
# Text-to-Speech (Kokoro) Configuration
# ───────────────────────────────────────────────────────────────────
# Voice to use (options: af_heart, am_adam, bf_emma, bm_george, etc)
KOKORO_VOICE=af_heart

# Speaking speed (0.5-2.0, default: 1.0)
KOKORO_SPEED=1.0

# Streaming TTS (US-005, build-approved 2026-09-19; adoption gated on DG-03).
# 1 = the first sentence of an answer is synthesised and sent while the rest
# of the answer still awaits synthesis (measured: first-audio p50 2,250 ms vs
# 2,453 batch; over-cap 13% vs 27%). 0 = the batch path, retained unchanged
# as the BRD-15 revert -- this one line is the whole rollback.
TTS_STREAM=0

# Streaming LLM generation (US-004, build-approved 2026-09-19; adoption
# gated on DG-03). 1 = the answer is consumed as clauses and (with
# TTS_STREAM=1) synthesised while the model decodes (measured: first-audio
# p50 1,625 ms vs 2,453 batch; over-cap 6% vs 27%). KNOWN DEFECT: the
# streamed path froze the event loop after ~35 turns under N=2 (suspect:
# phonemization on the loop under concurrent streams) -- keep 0 until the
# root-cause fix lands. 0 = the batch path, the BRD-15 revert.
LLM_STREAM=0

# TTS cache scope (US-012 AC-4).
#   shared    one process-wide cache, reused by every caller (the DG-06 design)
#   per_call  bounded to one session's utterances; no cross-caller reuse
# Default is per_call because the N=2 isolation condition FAILED: 30
# occurrences of caller B being served audio synthesised during caller A's
# session (MOD-04 A.5.2). AC-4 pre-decides that outcome -- the cache becomes
# per-call rather than the finding being argued away. Reverting to shared is
# this one line; no code change is involved.
TTS_CACHE_SCOPE=per_call

# Two-caller admission control (US-016 / BRD-05).
# A third inbound call is refused at the voice endpoint, hears the
# pre-synthesised busy message and connects no media stream -- rather than all
# three degrading. The limit is the BRD-05 sizing for this box. Set
# ADMISSION_ENABLED=false to restore the previous behaviour in one step.
# After a KOKORO_VOICE / KOKORO_SPEED change, rebuild the call assets:
#   .venv/Scripts/python.exe scripts/build_call_assets.py
MAX_CONCURRENT_CALLS=2
ADMISSION_ENABLED=true

# ───────────────────────────────────────────────────────────────────
# Caller interruption (US-014, Option 2 — "enable with bounded guard")
# ───────────────────────────────────────────────────────────────────
# Whether the caller can be heard while the agent is speaking.
#
# ON by default: the voice yields. A caller who speaks over the agent takes the
# floor — the agent stops mid-sentence, the carrier's buffered audio is flushed,
# and the interrupting words become the next turn.
#
# Setting this to 0 is the BRD-15 revert, and note what it reverts TO: the
# caller's overlapping speech is discarded and their partial utterance is reset.
# That is what the design documents always described and what the code did NOT
# do — before US-014 the guard was unreachable, so the real behaviour was to
# buffer the overlap and answer it as a fresh question after playback finished,
# i.e. the agent ignored the interruption and then answered it late.
BARGE_IN_ENABLED=1

# The echo gate: a frame is caller speech only if it clears
#     max(BARGE_IN_ABS_FLOOR, ref_env * ECHO_GAIN * MARGIN)
# where ref_env is the RMS of the audio the carrier is playing out right now.
#
# ECHO_GAIN is a DECLARED ASSUMPTION about the carrier's acoustic path (how much
# of our own voice comes back), not a local measurement -- US-002 TAC-9 puts the
# real path out of reach. MARGIN is how far above that echo the caller must be,
# and is ours to tune. They are separate keys so the assumption is visible in
# the tuning record instead of hidden inside one ratio.
#
# The defaults below are MEASURED, not decided by taste:
#   doc/perf/tools/measure_us014_guard.py   (the sweep)
#   doc/perf/us014-echo-guard-tuning.md     (the record, the rule, the limits)
# At these values: 0 false-admits on our own voice across echo gains -6..-24 dB,
# and a caller at the agent's own level is heard in every cell at ~160 ms. The
# known limit is a caller 12 dB quieter than the passage they talk over.
BARGE_IN_ECHO_GAIN=0.5
BARGE_IN_MARGIN=2.0

# Above is_silent's own 80, or the gate admits frames the VAD then discards as
# silence; below the quietest speech decile measured on the fixtures (~157), or
# a softly-spoken interruption is gated out.
BARGE_IN_ABS_FLOOR=150

# Consecutive admitting frames before a run is believed (6 x 20 ms = 120 ms).
BARGE_IN_MIN_FRAMES=6

# Per-tick decay of the playback reference once the carrier's buffer is drained.
BARGE_IN_REF_DECAY=0.95

# ───────────────────────────────────────────────────────────────────
# Voice Agent Identity (app/voice_system_prompt.py)
# ───────────────────────────────────────────────────────────────────
# How the voice agent introduces itself on calls. Used to fill the
# [COMPANY_NAME] / [AGENT_NAME] placeholders in the production voice
# system prompt. COMPANY_SHORT_NAME is for sentences where the full legal
# name is too long; ADMISSIONS_EMAIL/PHONE are the published contact details
# used by refusals, the prompt and localized messages.
COMPANY_NAME=Dr. Shyama Prasad Mukherjee University
COMPANY_SHORT_NAME=DSPMU
AGENT_NAME=Alex
ADMISSIONS_EMAIL=registrar@dspmuranchi.ac.in
ADMISSIONS_PHONE=+91 930 455 261
UNIVERSITY_WEBSITE=https://dspmuranchi.ac.in

# Programme catalogue: "dspmu" is the production catalogue built from
# content/dspmu/facts.json.
PROGRAM_PROFILE=dspmu

# Offer-letter identity. Leave DEFAULT_PAYMENT_LINK empty unless the
# university publishes a payment URL; an empty value is better than a link
# to the wrong institution.
UNIVERSITY_NAME=Dr. Shyama Prasad Mukherjee University
OFFER_EMAIL=registrar@dspmuranchi.ac.in
DEFAULT_PAYMENT_LINK=

# ───────────────────────────────────────────────────────────────────
# Integrations — fill these in for full functionality
# (bootstrap_services copies this template to .env on first run)
# ───────────────────────────────────────────────────────────────────
# Twilio (voice + WhatsApp) — https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# PostgreSQL connection (Docker compose default credentials shown;
# docker-compose.yml overrides the host to `postgres` inside the network)
DATABASE_URL=postgresql://elearning:elearning_secret@localhost:5432/admissions

# SMTP for offer-letter email delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ───────────────────────────────────────────────────────────────────
# Logging Configuration
# ───────────────────────────────────────────────────────────────────
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=./logs/voice_assistant.log

# ───────────────────────────────────────────────────────────────────
# GPU/Compute Configuration (Auto-detected)
# ───────────────────────────────────────────────────────────────────
# These are auto-detected by app/platform.py
# Only override if needed
# DEVICE=cuda  # or mps (Metal GPU), cpu
# COMPUTE_TYPE=int8  # or fp16, fp32

# ───────────────────────────────────────────────────────────────────
# Machine Profile (managed by scripts/predeploy.py — do not edit)
# ───────────────────────────────────────────────────────────────────
# The keys below are sized automatically for the machine at deploy
# time (RAM/VRAM/cores → model, context window, threads, workers).
# The block is rewritten on every predeploy run. To override a value
# manually, move it ABOVE this section (outside the block) — the app
# reads the value outside the block and predeploy will not touch it.
# Sizes: MACHINE_PROFILE_CHECK=0 disables the startup drift warning.
# === MACHINE PROFILE — auto-generated by scripts/predeploy.py (do not edit) ===
LLM_PROVIDER=auto
# US-015 screen, 2026-09-19: llama3.2:3b over qwen2.5:14b for the voice path.
# Over 83 golden-set cases the two miss required facts IDENTICALLY (28 each,
# paired discordance 7-7, McNemar p = 1.00) while the 14B breaks the 2-sentence
# spoken limit 2.3x as often (37 vs 16, paired 26-5, p = 0.0002). The 3B is
# also 4.1x faster on prefill and 5.4x on generation, batches at N=2 where the
# 14B only partially does, and holds 26% of VRAM against 69%. SCREEN-GRADE:
# no case carries PO approval (DG-03), so this is a measured operating choice,
# not an adoption decision. Reverse by setting OLLAMA_MODEL=qwen2.5:14b.
# Output-token ceiling for the SPOKEN answer. 192 truncates none of the 83
# measured answers (p95 was 106 for the 14B, 82 for the 3B); it exists to bound
# the worst case on a live call. Set 0 to remove it. Applies to the voice/RAG
# answer path ONLY -- never to structured output such as lead extraction.
WHISPER_MODEL=small
STT_LANGUAGE=auto
STT_LANGUAGE_MIN_PROB=0.5
# Changing the ANSWER language is a stronger claim than accepting a detection.
# On 8 kHz telephony Indic LID labels a single loanword ("admission") as another
# language at 0.6-0.7; a switch therefore needs this probability and this many
# characters. Explicit selections (IVR digit, outbound operator selection, or a
# spoken "speak in Hindi") are authoritative and ignore both.
STT_LANGUAGE_SWITCH_MIN_PROB=0.75
STT_LANGUAGE_SWITCH_MIN_CHARS=12
WHISPER_NUM_THREADS=4
FASTAPI_WORKERS=4
# === END MACHINE PROFILE ===


# ── Remote LLM: OpenAI (opt-in) ────────────────────────────────────────
# Code default is LLM_PROVIDER=auto (local, unchanged). To use OpenAI:
#   1) fill LLM_API_KEY below
#   2) uncomment LLM_PROVIDER=openai (after the profile block on purpose:
#      python-dotenv keeps the LAST definition of a duplicate key)
#   3) restart
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=15
LLM_MAX_TOKENS=192
LLM_REASONING_EFFORT=none
LLM_PROMPT_CACHE_KEY=dspmu-kb-v3
# LLM_PROVIDER=openai

# ── Document context (no embeddings) ──────────────────────────────────
# DSPMU prompt split, generated by scripts/build_site_index.py.
# DOC_PATHS is the prompt corpus: core cards + compact site map + volatile
# notices. voice_kb.md is the full entity corpus and is NOT in the prompt.
# The build fails if the full voice prompt exceeds 8k tokens.
# site uses the deterministic selective router: core cards plus the fee fact,
# page node or non-PII notices the question needs. Unknown questions fall back
# to the full compact bundle. doc bypasses the router.
CONTEXT_MODE=site
DOC_PATHS=content/dspmu/core_cards.md,content/dspmu/site_map.md,content/dspmu/recent_notices.md
DOC_MAX_BYTES=2000000
DOC_MAX_TOKENS=4000
VOICE_KB_PATH=content/dspmu/voice_kb.md
CONTEXT_MANIFEST_PATH=content/dspmu/prompt_manifest.json
# Selective-router inputs (CONTEXT_MODE=site).
SITE_FACTS_PATH=content/dspmu/facts.json
SITE_NOTICES_PATH=content/dspmu/notices.jsonl
# FTS5 index rebuilt from the JSONL; missing/unreadable falls back to the title scan.
SITE_NOTICE_DB_PATH=content/dspmu/notices.sqlite3
SITE_NODES_DIR=content/dspmu/nodes
SITE_ROUTER_MAX_NOTICES=5
# ── NGA navigation graph (Phase 1) ─────────────────────────────────
# The graph compiler is an offline/background tool. It is not wired into the
# answer path. Keep NGA_ENABLED=false until the later phase gates pass.
NGA_ENABLED=false
NGA_MODE=off
# Product decision 2026-10-24: the university already publishes these pages,
# so the chat may use them. Set true to restore the PII/title exclusions and
# recompile the graph.
NGA_PII_GUARD_ENABLED=false
NGA_SITE_BASE_URL=https://dspmuranchi.ac.in
NGA_SITEMAP_URL=https://dspmuranchi.ac.in/sitemap.xml
NGA_ALLOWED_HOSTS=dspmuranchi.ac.in,www.dspmuranchi.ac.in
NGA_BLOCKED_PATH_TOKENS=result,results,merit,selection,selected,waiting,answer,admit,archive,awarded,departments,faculties,staff,faculty,teaching,nonteaching
NGA_GRAPH_SQLITE_PATH=content/dspmu/nga_graph.sqlite3
NGA_COVERAGE_PATH=content/dspmu/nga_coverage.json
NGA_NOTICES_PATH=content/dspmu/notices.jsonl
NGA_COVERAGE_MIN=0.95
NGA_FETCH_TIMEOUT_S=6
NGA_FETCH_DELAY_S=0.25
NGA_MAX_BYTES=2000000
NGA_MIN_PAGE_CHARS=120
NGA_TTL_PAGE_S=86400
NGA_TTL_NOTICE_S=300
NGA_TTL_NAV_S=3600
NGA_REFRESH_LIMIT=10
NGA_ROBOTS_RESPECT=true
NGA_SESSION_HISTORY_TURNS=6
NGA_EVENT_RETENTION_DAYS=90
# Shadow mode computes live evidence without changing the user answer.
# It requires NGA_ENABLED=true and NGA_MODE=shadow.
NGA_SHADOW_LOG_PATH=logs/nga_shadow.jsonl
NGA_SHADOW_GENERATE=false
NGA_SHADOW_MAX_WORKERS=2
NGA_SHADOW_SAMPLE_RATE=1.0
NGA_SHADOW_LOG_QUERIES=false
NGA_SHADOW_DEADLINE_MS=8000
NGA_SHADOW_MAX_STEPS=8
NGA_SHADOW_MAX_CHARS=3000
# Voice fast path: deterministic plan, max 2 tool calls, hard deadline.
NGA_VOICE_DEADLINE_MS=1500
NGA_VOICE_MAX_STEPS=2
NGA_VOICE_MAX_CHARS=1200
# Text agentic path (chat/WhatsApp).
NGA_TEXT_DEADLINE_MS=8000
NGA_TEXT_MAX_STEPS=8
NGA_TEXT_MAX_CHARS=4000
NGA_TEXT_LLM_PLANNER=false
# ── NGA refresh scheduler and alerts (Phase 10) ─────────────────────
# A separate background process; enabling NGA_ENABLED never starts fetching.
NGA_SCHEDULER_ENABLED=false
NGA_REFRESH_INTERVAL_S=900
NGA_REFRESH_JITTER_S=60
NGA_REFRESH_MAX_CYCLES=0
NGA_REFRESH_REPORT_PATH=content/dspmu/nga_refresh_report.json
NGA_REFRESH_LOG_PATH=logs/nga_refresh.jsonl
NGA_ALERT_LOG_PATH=logs/nga_alerts.jsonl
NGA_REFRESH_LOCK_PATH=content/dspmu/nga_refresh.lock
# Alert thresholds; see doc/ops/nga-runbook.md.
NGA_ALERT_COVERAGE_DROP=0.02
NGA_ALERT_RUN_FAILURE_STREAK=3
NGA_ALERT_NODE_FAILURE_STREAK=3
NGA_ALERT_ERROR_RATE=0.5
NGA_ALERT_EMPTY_SHELL_RATE=0.35
NGA_ALERT_SOFT_404_RATE=0.25
NGA_ALERT_STALE_NODES=50
NGA_ALERT_STALE_GRACE_S=7200
NGA_ALERT_GRAPH_STALE_HOURS=168
# ── NGA background PDF/OCR index (Phase 11) ────────────────────────
# The worker fetches and extracts linked PDFs; the live path reads the index.
# OCR text is not answerable until reviewed with scripts/nga_documents.py.
NGA_PDF_INDEX_ENABLED=false
NGA_TTL_DOCUMENT_S=604800
NGA_PDF_REFRESH_LIMIT=5
NGA_PDF_MAX_BYTES=10000000
NGA_PDF_MAX_PAGES=40
NGA_PDF_MIN_CHARS=80
NGA_PDF_OCR_ENABLED=true
NGA_PDF_OCR_MAX_PAGES=8
NGA_PDF_OCR_LANGS=
NGA_PDF_FAILURE_BACKOFF_S=3600
NGA_ALERT_DOCUMENT_ERROR_RATE=0.5
NGA_ALERT_REVIEW_BACKLOG=25
# ── NGA references and voice→WhatsApp delivery (Phase 12) ──────────
# Cited chat/WhatsApp answers always show title + snippet + href. This flag
# enables delivery of those references to a registered caller's WhatsApp after
# a voice turn.
NGA_REFERENCE_DELIVERY_ENABLED=false
NGA_REFERENCE_DELIVERY_MODE=turn
NGA_REFERENCE_MAX_PER_CALL=3
NGA_REFERENCE_MIN_INTERVAL_S=20
NGA_REFERENCE_SNIPPET_CHARS=240
NGA_WHATSAPP_REGISTRATION_WINDOW_DAYS=30
NGA_WHATSAPP_REFERENCE_REQUIRE_OPT_IN=false
NGA_WHATSAPP_TEMPLATE_SID=
NGA_REFERENCE_RETRY_MAX=3
NGA_REFERENCE_RETRY_BACKOFF_S=2.0
NGA_REFERENCE_LOG_RETENTION_DAYS=30
NGA_ALERT_REFERENCE_WINDOW_S=3600
NGA_ALERT_REFERENCE_FAILURES=3
NGA_ALERT_TEMPLATE_REQUIRED=3
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,as,bn,brx,gu,kn,ml,mni,mr,or,raj,ta,te,es,fr,it,ja,pt,zh
# Non-Indian languages enabled end to end. Empty disables the feature.
FOREIGN_LANGUAGES=es,fr,it,ja,pt,zh
# Campaign default for outbound calls whose lead has no recorded conversation
# language. A per-call operator selection (POST /api/quick-call {"language":...}
# or the /call page dropdown) always wins and LOCKS the language; then the
# lead's stored language (soft: strong auto-detection may still switch); then
# this campaign default (locks). Empty keeps the pre-language behaviour
# (English) and leaves the TwiML URL unchanged; set hi/gu to make a non-English
# campaign the fallback.
# OUTBOUND_LANGUAGE=
# Ask the callee which language to continue in as soon as an outbound call is
# answered: a one-digit DTMF menu (1 English, 2 Hindi, 3 Gujarati; 4 keeps the
# fallback language above, as does the 10 s timeout). With FOREIGN_LANGUAGES
# non-empty, 9 opens the second-level menu (1 Spanish, 2 French, 3 Italian,
# 4 Japanese, 5 Portuguese, 6 Chinese). The pressed digit is sent
# as languageSource=selected and locks the call's language. The prompt is
# pre-rendered in the fallback language by scripts/build_call_assets.py.
# 0 restores the old behaviour: connect straight to the media stream.
OUTBOUND_LANGUAGE_MENU=1
# Ask a WhatsApp number with no explicit language choice which language to
# continue in before answering its first message: a numbered menu (English,
# Hindi, Gujarati + the enabled foreign languages). The choice is saved on the
# conversation's language with its source; returning numbers skip the menu and
# legacy implicit-default rows are asked once. 0 restores the old behavior.
WHATSAPP_LANGUAGE_MENU=1
GROUNDING_LANGUAGE_MODE=relaxed

# ── TTS provider ──────────────────────────────────────────────────────
# kokoro preserves today's behaviour. Switch to indic_tts once the isolated
# AI4Bharat service is running; Hindi falls back to Kokoro hf_alpha.
# sarvam routes SARVAM_TTS_LANGUAGES to Bulbul v4 Flash; the rest stay Kokoro.
# Gujarati has no Kokoro voice. Hindi is on Bulbul because Kokoro hf_alpha
# mangles code-mixed Latin acronyms ("MBA" -> "ambhee") and vocalises the
# phonemizer's language-switch flags. Without SARVAM_API_KEY, Hindi falls back
# to Kokoro; Gujarati has no local fallback.
TTS_PROVIDER=sarvam
SARVAM_TTS_LANGUAGES=gu,hi

# Pre-synthesise the fixed opening greeting for en/hi/gu after startup, so the
# first caller does not pay the cold TTS path. Background work; 0 disables it.
GREETING_WARMUP=1
SARVAM_TTS_MODEL=bulbul:v4-flash
# Persona IDs carry their language. Use the per-language map; the legacy
# single-language SARVAM_TTS_SPEAKER applies only when its persona matches the
# requested language (a Gujarati value is ignored for Hindi, with a warning).
# Gujarati: pooja_gu_customer, pooja_gu_conversational, bhavik_gu_conversation.
# Hindi: aparna_hi_customer.
SARVAM_TTS_SPEAKER=
SARVAM_TTS_SPEAKERS=gu:pooja_gu_customer,hi:aparna_hi_customer
SARVAM_TTS_PACE=1.1
# HTTP streaming supports 8000-24000; 8000 is the Twilio carrier rate.
SARVAM_TTS_SAMPLE_RATE=8000
SARVAM_TTS_TIMEOUT_S=15
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech/stream
# Local Indic-TTS remains the fallback service if it is brought up.
INDIC_TTS_URL=http://127.0.0.1:8020
INDIC_TTS_LANGUAGE=hi


# ════════════════════════════════════════════════════════════════════
# Salesforce admission API (CRM)
# ════════════════════════════════════════════════════════════════════
# Master switch for the whole CRM integration. ON by default (this repo's
# integration is built and gate-verified); set it to false to disable the
# integration instantly -- with it off nothing in the app calls Salesforce
# and behaviour is identical to before the integration.
CRM_ENABLED=true
# The admission API. Loopback dev deployment (plan decision D2).
CRM_BASE_URL=http://127.0.0.1:8098
# WhatsApp has no session and no end event, so "one conversation" is defined
# by this idle window (plan decision D4).
CRM_IDLE_WINDOW_HOURS=6
# Separate switch for the one CRM write that leaves residue we cannot remove:
# document uploads create a ContentVersion, and the API has no delete route.
CRM_OFFER_UPLOAD_ENABLED=true
# ContentVersion.Document_Type__c is a RESTRICTED picklist and the org has no
# offer-letter value yet — "Other" is the only honest fit. Change this to
# "Offer Letter" once an admin adds it, and re-run
#   scripts/verify_offer_document_upload.py --describe-only
CRM_OFFER_DOCUMENT_TYPE=Other
# Source__c is restricted too; "Internal Upload" is the only value the org uses.
CRM_OFFER_DOCUMENT_SOURCE=Internal Upload
# The student's own documents (transcript, ID proof) — separate from the offer
# letter because these carry grades and identity documents.
CRM_DOCUMENT_UPLOAD_ENABLED=true


# ── Hindi OCR (build / notice extraction; not runtime voice) ───────
# Install the ~12 MB Hindi model with scripts/install_hindi_ocr.py.
# The extractor uses .tessdata automatically when present. The English PG
# admission notice stays on eng; notice-body OCR defaults to eng,hin and is
# review-only.
# TESSERACT_TESSDATA_DIR=.tessdata
# TESSERACT_OCR_LANGS=eng,hin

# ════════════════════════════════════════════════════════════════════
# Speech-to-text provider chain (2026-10)
# ════════════════════════════════════════════════════════════════════
# whisper | sarvam | indic_conformer
# sarvam = Sarvam Saaras v4 (Indic-first, 8 kHz telephony, domain keyterms).
# indic_conformer = AI4Bharat IndicConformer-600M ONNX, fully offline fallback.
STT_PROVIDER=sarvam
STT_FALLBACK_PROVIDERS=indic_conformer,whisper
# Fill this to enable Sarvam. With it empty the chain falls through to
# IndicConformer, then faster-whisper.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# codemix keeps BA/B.Sc/fees in Latin script while Hindi stays Devanagari.
SARVAM_STT_MODE=codemix
SARVAM_STT_TIMEOUT_S=8
# Optional comma-separated override (max 50, 64 chars each). Empty uses the
# built-in DSPMU programme/fee/admission list in app/stt_sarvam.py.
# SARVAM_STT_KEYTERMS=Dr. Shyama Prasad Mukherjee University,DSPMU,BA,B.Sc,B.Com,fees
INDIC_CONFORMER_MODEL_HI=OpenVoiceOS/ai4bharat-indicconformer-hi-onnx
INDIC_CONFORMER_MODEL_GU=OpenVoiceOS/ai4bharat-indicconformer-gu-onnx
INDIC_CONFORMER_QUANTIZATION=int8
# cpu | cuda. CPU int8 is ~0.25x RTF and does not compete with Kokoro/Whisper.
INDIC_CONFORMER_DEVICE=cpu
# Cloud STT is billed per request; keep speculation for local providers only.
STT_SPECULATIVE_ENABLED=1
