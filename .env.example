# Environment Configuration Template
# This file is auto-generated by setup.sh
# Edit values below to customize your setup

# ───────────────────────────────────────────────────────────────────
# Python Configuration
# ───────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONHASHSEED=0

# ───────────────────────────────────────────────────────────────────
# LLM Backend Selection (see app/llm_backend.py)
# ───────────────────────────────────────────────────────────────────
# auto = MLX on Apple Silicon (Darwin+arm64), Ollama everywhere else.
# Force a backend with: LLM_PROVIDER=ollama or LLM_PROVIDER=mlx
# NOTE for Docker: containers run Linux, so leave this unset/auto —
# setting LLM_PROVIDER=mlx inside containers would look for a local
# MLX server that only exists on the Mac host.
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Ollama LLM Server Configuration (Windows / Linux)
# ───────────────────────────────────────────────────────────────────
# URL to Ollama server (default: local).
# Use the literal IPv4, NOT "localhost". On Windows "localhost" resolves to
# ::1 first while Ollama binds IPv4 only, so every model-resolution call pays
# ~2,066 ms in SYN retransmits before falling back to 127.0.0.1. Measured on
# this box: localhost 2,034 ms vs 127.0.0.1 5 ms. Docker overrides this with
# http://ollama:11434, so changing it here does not affect containers.
OLLAMA_URL=http://127.0.0.1:11434

# Keep the model resident between calls. -1 = never unload. Must be an INT
# (Ollama's Go duration parser rejects the string "-1" with a 400); a duration
# such as "24h" stays a string. Without this the first chat resets the boot
# pre-warm to Ollama's 5-minute default and the next caller pays a cold reload.
OLLAMA_KEEP_ALIVE=-1

# Context window for small utility calls (intent detection, lead extraction,
# sentiment). LEAVE UNSET unless you have measured a reason to differ.
# Ollama keeps one runner per model and tears it down whenever a request
# arrives with a different num_ctx, so five call sites with their own values
# (512/1024/2048/4096) against the voice path's 8192 caused a ~6-11 s reload
# on the next voice turn. The code now defaults every call site to
# OLLAMA_NUM_CTX, so agreement holds without this key. Set it only to
# deliberately diverge -- and expect the reload cost if you do.
# SMALL_TASK_NUM_CTX=8192

# Model to use and context window size — sized per machine by
# scripts/predeploy.py (see the Machine Profile block at the bottom).
# Q3_K_M chosen for 6 GB VRAM cards; 14B/7B-4bit MLX on Apple Silicon.
# Voice calls run the production voice system prompt (~3.5k tokens) plus
# RAG context, so the context window must stay ≥8192 where RAM allows.

# Temperature (0.0-1.0): 0=deterministic, 1=creative
# 0.3 = grounded QA (live value); empty = Ollama default
OLLAMA_TEMPERATURE=0.3

# ───────────────────────────────────────────────────────────────────
# Apple MLX LLM Server Configuration (macOS Apple Silicon)
# ───────────────────────────────────────────────────────────────────
# mlx_lm.server (OpenAI-compatible) started by start_services.sh /
# bootstrap_services.py — replaces Ollama for LLM inference on Mac.
MLX_BASE_URL=http://127.0.0.1:1234
MLX_PORT=1234

# MLX model repo on HuggingFace (~9 GB download, ~11 GB unified RAM).
# Smaller/faster alternative: mlx-community/Qwen2.5-7B-Instruct-4bit
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# Local embedding model on Mac (no Ollama there); 768-dim nomic family,
# dimension-compatible with the Ollama nomic-embed-text store.
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# FastAPI Server Configuration
# ───────────────────────────────────────────────────────────────────
# Port to run FastAPI on
FASTAPI_PORT=8000

# Host to bind to (0.0.0.0 = accept from any host)
FASTAPI_HOST=0.0.0.0

# Number of worker processes (in production)
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Streamlit Web UI Configuration
# ───────────────────────────────────────────────────────────────────
# Port to run Streamlit on (usually FASTAPI_PORT + 501)
STREAMLIT_PORT=8501

# Run in headless mode (no browser opening)
STREAMLIT_SERVER_HEADLESS=true

# ───────────────────────────────────────────────────────────────────
# Speech-to-Text (Whisper) Configuration
# ───────────────────────────────────────────────────────────────────
# Model size (options: tiny.en, base.en, small.en, medium.en, large)
# tiny: 39M, base: 74M, small: 244M, medium: 769M, large: 3.1G
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# Number of threads for computation
# Sized by scripts/predeploy.py — see the Machine Profile block at the bottom.

# ───────────────────────────────────────────────────────────────────
# Text-to-Speech (Kokoro) Configuration
# ───────────────────────────────────────────────────────────────────
# Voice to use (options: af_heart, am_adam, bf_emma, bm_george, etc)
KOKORO_VOICE=af_heart

# Speaking speed (0.5-2.0, default: 1.0)
KOKORO_SPEED=1.0

# TTS cache scope (US-012 AC-4).
#   shared    one process-wide cache, reused by every caller (the DG-06 design)
#   per_call  bounded to one session's utterances; no cross-caller reuse
# Default is per_call because the N=2 isolation condition FAILED: 30
# occurrences of caller B being served audio synthesised during caller A's
# session (MOD-04 A.5.2). AC-4 pre-decides that outcome -- the cache becomes
# per-call rather than the finding being argued away. Reverting to shared is
# this one line; no code change is involved.
TTS_CACHE_SCOPE=per_call

# Two-caller admission control (US-016 / BRD-05).
# A third inbound call is refused at the voice endpoint, hears the
# pre-synthesised busy message and connects no media stream -- rather than all
# three degrading. The limit is the BRD-05 sizing for this box. Set
# ADMISSION_ENABLED=false to restore the previous behaviour in one step.
# After a KOKORO_VOICE / KOKORO_SPEED change, rebuild the call assets:
#   .venv/Scripts/python.exe scripts/build_call_assets.py
MAX_CONCURRENT_CALLS=2
ADMISSION_ENABLED=true

# ───────────────────────────────────────────────────────────────────
# Voice Agent Identity (app/voice_system_prompt.py)
# ───────────────────────────────────────────────────────────────────
# How the voice agent introduces itself on calls. Used to fill the
# [COMPANY_NAME] / [AGENT_NAME] placeholders in the production voice
# system prompt.
COMPANY_NAME=Meridian University
AGENT_NAME=Alex

# ───────────────────────────────────────────────────────────────────
# Vector Database (Chroma) Configuration
# ───────────────────────────────────────────────────────────────────
# Path to Chroma database (default: ./chroma_local_db)
CHROMA_DB_PATH=./chroma_local_db

# Retrieval mode: "mmr" (default) or "hybrid" (dense + BM25 + RRF)
RAG_SEARCH_MODE=hybrid

# Number of results to retrieve for RAG — sized by scripts/predeploy.py
# (see the Machine Profile block at the bottom).

# Candidate pool size for retrieval — sized by scripts/predeploy.py
# (see the Machine Profile block at the bottom).

# Similarity threshold gate (cosine distance): 0.0 = DISABLED (live value —
# measured distances overlap between valid and off-topic questions, so a
# global gate would reject valid ones; revisit with per-section gating)
RAG_SIMILARITY_THRESHOLD=0.0

# Context overflow guard: 0 = off (warn only); N = trim context to N chars
RAG_MAX_CONTEXT_CHARS=0

# Embedding model served by Ollama for the vector store
EMBED_MODEL=nomic-embed-text

# ───────────────────────────────────────────────────────────────────
# Integrations — fill these in for full functionality
# (bootstrap_services copies this template to .env on first run)
# ───────────────────────────────────────────────────────────────────
# Twilio (voice + WhatsApp) — https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# PostgreSQL connection (Docker compose default credentials shown;
# docker-compose.yml overrides the host to `postgres` inside the network)
DATABASE_URL=postgresql://elearning:elearning_secret@localhost:5432/admissions

# SMTP for offer-letter email delivery (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ───────────────────────────────────────────────────────────────────
# Logging Configuration
# ───────────────────────────────────────────────────────────────────
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=./logs/voice_assistant.log

# ───────────────────────────────────────────────────────────────────
# GPU/Compute Configuration (Auto-detected)
# ───────────────────────────────────────────────────────────────────
# These are auto-detected by app/platform.py
# Only override if needed
# DEVICE=cuda  # or mps (Metal GPU), cpu
# COMPUTE_TYPE=int8  # or fp16, fp32

# ───────────────────────────────────────────────────────────────────
# Machine Profile (managed by scripts/predeploy.py — do not edit)
# ───────────────────────────────────────────────────────────────────
# The keys below are sized automatically for the machine at deploy
# time (RAM/VRAM/cores → model, context window, threads, workers).
# The block is rewritten on every predeploy run. To override a value
# manually, move it ABOVE this section (outside the block) — the app
# reads the value outside the block and predeploy will not touch it.
# Sizes: MACHINE_PROFILE_CHECK=0 disables the startup drift warning.
# === MACHINE PROFILE — auto-generated by scripts/predeploy.py (do not edit) ===
LLM_PROVIDER=auto
MLX_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit
MLX_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
OLLAMA_MODEL=qwen2.5:7b-instruct-q3_K_M
OLLAMA_NUM_CTX=8192
WHISPER_MODEL=small.en
WHISPER_NUM_THREADS=4
FASTAPI_WORKERS=4
RAG_TOP_K=5
RAG_FETCH_K=20
# === END MACHINE PROFILE ===


# === Enterprise RAG Core (MCP-first retrieval) ===
# MCP retrieval mode: auto (default) = MCP first, automatic fallback to the
# local ChromaDB store; on = MCP only; off = local store only.
USE_MCP_RAG=auto
# enterprise-rag-core MCP service (started by start_services.ps1 Step 6b)
RAG_MCP_URL=http://127.0.0.1:8010/mcp
# Read timeout (s) and circuit-breaker cooldown (s) for the MCP client.
# 6.0, not 2.5: under load ERC's embedding call queues behind Ollama
# generation, so a 2.5 s read timeout fires on a service that answers in
# milliseconds -- and the fallback then pays for a SECOND embedding, on top
# of the timeout. Measured: p95 7,850 -> 5,538 ms. Waiting is cheaper.
RAG_MCP_TIMEOUT=6.0
RAG_MCP_COOLDOWN=30

# Retrieval circuit breaker mode (US-013 / BRD-15).
#   probe  closed / open / half_open -- one cheap probe per cooldown window, at
#          a fraction of the read timeout (RAG_MCP_PROBE_FRACTION below)
#   flat   closed / open -- the pre-US-013 behaviour: an elapsed cooldown serves
#          the primary again at the FULL read timeout, blind, every window
# Default is probe. The flat mode exists so US-013's revert is a SETTING rather
# than a code change; it is a defect, not an option to run with.
RAG_BREAKER_MODE=probe
# Probe budget as a fraction of RAG_MCP_TIMEOUT, floored at 0.5 s.
RAG_MCP_PROBE_FRACTION=0.25
# The whole retrieval operation's budget, fallback included (US-013 AC-1).
# The primary attempt is capped at (budget - RAG_FALLBACK_RESERVE).
RAG_RETRIEVAL_BUDGET=8.0
RAG_FALLBACK_RESERVE=1.5


# ════════════════════════════════════════════════════════════════════
# Salesforce admission API (CRM)
# ════════════════════════════════════════════════════════════════════
# Master switch for the whole CRM integration. ON by default (this repo's
# integration is built and gate-verified); set it to false to disable the
# integration instantly -- with it off nothing in the app calls Salesforce
# and behaviour is identical to before the integration.
CRM_ENABLED=true
# The admission API. Loopback dev deployment (plan decision D2).
CRM_BASE_URL=http://127.0.0.1:8098
# WhatsApp has no session and no end event, so "one conversation" is defined
# by this idle window (plan decision D4).
CRM_IDLE_WINDOW_HOURS=6
# Separate switch for the one CRM write that leaves residue we cannot remove:
# document uploads create a ContentVersion, and the API has no delete route.
CRM_OFFER_UPLOAD_ENABLED=true
# ContentVersion.Document_Type__c is a RESTRICTED picklist and the org has no
# offer-letter value yet — "Other" is the only honest fit. Change this to
# "Offer Letter" once an admin adds it, and re-run
#   scripts/verify_offer_document_upload.py --describe-only
CRM_OFFER_DOCUMENT_TYPE=Other
# Source__c is restricted too; "Internal Upload" is the only value the org uses.
CRM_OFFER_DOCUMENT_SOURCE=Internal Upload
# The student's own documents (transcript, ID proof) — separate from the offer
# letter because these carry grades and identity documents.
CRM_DOCUMENT_UPLOAD_ENABLED=true
